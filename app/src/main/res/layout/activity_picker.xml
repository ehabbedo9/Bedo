<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/pickBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_small"
            android:clickable="true"
            android:contentDescription="رجوع"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:tint="@color/brown" />

        <TextView
            android:id="@+id/pickTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_extrabold"
            android:textColor="@color/brown"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pickTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tabOld"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preset"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:text="العهد القديم"
            android:textColor="@color/brown"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabNew"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preset"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:text="العهد الجديد"
            android:textColor="@color/brown"
            android:textSize="15sp" />
    </LinearLayout>

    <GridView
        android:id="@+id/pickGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="8dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="2"
        android:padding="16dp"
        android:scrollbars="none"
        android:verticalSpacing="8dp" />
</LinearLayout>
