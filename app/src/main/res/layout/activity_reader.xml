<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_small"
            android:clickable="true"
            android:contentDescription="رجوع إلى الرئيسية"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:tint="@color/brown" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chapterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold"
                android:includeFontPadding="false"
                android:textColor="@color/brown"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/chapterSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="@color/brown_mid"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fontButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_small"
            android:clickable="true"
            android:contentDescription="حجم الخط"
            android:focusable="true"
            android:fontFamily="@font/cairo_extrabold"
            android:gravity="center"
            android:text="أ+"
            android:textColor="@color/brown"
            android:textSize="15sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/scrollProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="1000"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/progress_yellow" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/chapterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri_regular"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp"
            android:textColor="@color/brown"
            android:textDirection="rtl"
            android:textSize="23sp" />
    </ScrollView>

    <!-- Bottom panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_small"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="وصلت إلى"
                    android:textColor="@color/brown_mid"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/verseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/brown"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_small"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="أقل وقت للقراءة"
                    android:textColor="@color/brown_mid"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/timeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/brown"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/finishButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_finish"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:fontFamily="@font/cairo_extrabold"
            android:gravity="center"
            android:text="أنهيت الأصحاح"
            android:textColor="@color/disabled_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/finishHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="يُفعَّل الزر عند الوصول لآخر الأصحاح وانتهاء الوقت."
            android:textColor="@color/brown_mid"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
