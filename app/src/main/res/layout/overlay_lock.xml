<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown_deep"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="72dp"
    android:paddingEnd="24dp"
    android:paddingBottom="40dp">

    <ImageView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_circle_yellow"
        android:importantForAccessibility="no"
        android:padding="27dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/brown_deep" />

    <TextView
        android:id="@+id/lockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/cairo_bold"
        android:textColor="@color/yellow_bright"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/cairo_extrabold"
        android:gravity="center"
        android:text="اقرأ أصحاحاتك أولًا"
        android:textColor="@color/cream"
        android:textSize="28sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:text="يُفتح التطبيق بعد إكمال قراءة اليوم."
        android:textColor="@color/sand"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_bold"
                android:text="قراءة اليوم"
                android:textColor="@color/cream"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lockProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold"
                android:textColor="@color/yellow_bright"
                android:textSize="15sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/lockProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:mirrorForRtl="true"
            android:progressDrawable="@drawable/progress_dark" />

        <TextView
            android:id="@+id/lockNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/cairo_regular"
            android:textColor="@color/sand"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/amiri_regular"
        android:gravity="center"
        android:text="«سراج لرجلي كلامك ونور لسبيلي.»"
        android:textColor="@color/cream"
        android:textSize="21sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:text="المزامير ١١٩: ١٠٥"
        android:textColor="@color/sand"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/lockContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_yellow"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_extrabold"
        android:gravity="center"
        android:text="كمّل القراءة"
        android:textColor="@color/brown_deep"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/lockExit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:text="خروج من التطبيق"
        android:textColor="@color/sand"
        android:textSize="15sp" />
</LinearLayout>
